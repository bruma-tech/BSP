generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  role          String         @default("user")
  accounts      Account[]
  comments      Comment[]
  documents     Document[]
  notifications Notification[]
  sessions      Session[]
  sponsor       Sponsor?
  tpa           Tpa?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Tpa {
  id               String        @id @default(cuid())
  userId           String        @unique
  organizationName String
  contactNumber    String
  address          String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  requirements     Requirement[]
  reviews          Review[]
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sponsors         TpaSponsor[]

  @@index([userId])
  @@map("tpa")
}

model Sponsor {
  id                  String               @id @default(cuid())
  userId              String               @unique
  organizationName    String
  contactNumber       String
  address             String
  status              SponsorStatus        @default(PENDING)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  plans               Plan[]
  requirementSponsors RequirementSponsor[]
  reviews             Review[]
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tpas                TpaSponsor[]

  @@index([userId])
  @@map("sponsor")
}

model TpaSponsor {
  id        String   @id @default(cuid())
  tpaId     String
  sponsorId String
  createdAt DateTime @default(now())
  sponsor   Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  tpa       Tpa      @relation(fields: [tpaId], references: [id], onDelete: Cascade)

  @@unique([tpaId, sponsorId])
  @@index([tpaId])
  @@index([sponsorId])
  @@map("tpa_sponsor")
}

model Plan {
  id            String        @id @default(cuid())
  sponsorId     String
  planName      String
  planType      String
  description   String?
  effectiveDate DateTime?
  status        PlanStatus    @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sponsor       Sponsor       @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  requirements  Requirement[]

  @@index([sponsorId])
  @@map("plan")
}

model Requirement {
  id                 String               @id @default(cuid())
  tpaId              String
  planId             String
  title              String
  description        String?
  type               RequirementType      @default(OTHER)
  priority           RequirementPriority  @default(MEDIUM)
  rules              String?
  policies           String?
  documentSpecs      String?
  approvalWorkflow   ApprovalWorkflow     @default(SINGLE_REVIEWER)
  notifyOnSubmission Boolean              @default(true)
  allowResubmission  Boolean              @default(true)
  dueDate            DateTime?
  assignedAt         DateTime?
  closedAt           DateTime?
  status             RequirementStatus    @default(OPEN)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  comments           Comment[]
  plan               Plan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  tpa                Tpa                  @relation(fields: [tpaId], references: [id], onDelete: Cascade)
  sponsors           RequirementSponsor[]
  reviews            Review[]

  @@index([tpaId])
  @@index([planId])
  @@index([status])
  @@map("requirement")
}

model RequirementSponsor {
  id            String      @id @default(cuid())
  requirementId String
  sponsorId     String
  createdAt     DateTime    @default(now())
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  sponsor       Sponsor     @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([requirementId, sponsorId])
  @@index([requirementId])
  @@index([sponsorId])
  @@map("requirement_sponsor")
}

model Review {
  id            String       @id @default(cuid())
  requirementId String
  sponsorId     String
  tpaId         String
  status        ReviewStatus @default(OPEN)
  submittedAt   DateTime?
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comments      Comment[]
  documents     Document[]
  requirement   Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  sponsor       Sponsor      @relation(fields: [sponsorId], references: [id])
  tpa           Tpa          @relation(fields: [tpaId], references: [id])

  @@index([requirementId])
  @@index([sponsorId])
  @@index([tpaId])
  @@map("review")
}

model Document {
  id             String         @id @default(cuid())
  reviewId       String
  filePath       String
  fileName       String
  fileSize       String?
  fileFormat     String?
  version        Int            @default(1)
  description    String?
  certifications String[]
  effectiveDate  DateTime?
  expirationDate DateTime?
  status         DocumentStatus @default(PENDING_REVIEW)
  uploadedAt     DateTime       @default(now())
  uploadedById   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  review         Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])

  @@index([reviewId])
  @@index([uploadedById])
  @@map("document")
}

model Comment {
  id                String       @id @default(cuid())
  reviewId          String?
  requirementId     String?
  authorId          String
  content           String
  isRevisionRequest Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  author            User         @relation(fields: [authorId], references: [id])
  requirement       Requirement? @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  review            Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([requirementId])
  @@index([authorId])
  @@map("comment")
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  message        String
  actionRequired Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@map("notification")
}

enum SponsorStatus {
  ACTIVE
  PENDING
  INACTIVE
  SUSPENDED
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum RequirementStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CLOSED
}

enum RequirementPriority {
  LOW
  MEDIUM
  HIGH
}

enum RequirementType {
  FINANCIAL_REPORT
  COMPLIANCE_DOCUMENT
  PLAN_DOCUMENT
  AUDIT_REPORT
  TAX_FILING
  LEGAL_DOCUMENT
  OTHER
}

enum ApprovalWorkflow {
  SINGLE_REVIEWER
  MULTI_REVIEWER
  SEQUENTIAL
}

enum ReviewStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum NotificationType {
  NEW_REQUIREMENT
  DEADLINE_APPROACHING
  REVIEW_DECISION
  FEEDBACK_RECEIVED
}
